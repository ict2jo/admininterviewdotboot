<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ict.admininterviewdotboot.mapper.CommentsSuccMapper">
    <select id="getComments" resultType="CommentsSuccVO">
        SELECT * FROM Success_com WHERE s_idx = #{s_idx}
    </select>
    <update id="deleteComment" parameterType="CommentsSuccVO">
        UPDATE Success_com
        SET active = #{active}
        WHERE su_idx = #{su_idx}
    </update>
</mapper>