<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ict.admininterviewdotboot.mapper.CommentsMapper">
    <select id="getComments" resultType="CommentVO">
        SELECT * FROM Review_com  WHERE r_idx = #{r_idx}
    </select>
    <update id="deleteComment" parameterType="CommentVO">
        UPDATE Review_com
        SET active = #{active}
        WHERE re_idx = #{re_idx}
    </update>
</mapper>