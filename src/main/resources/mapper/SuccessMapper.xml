<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ict.admininterviewdotboot.mapper.SuccessMapper">    
    <select id="getSuccessList" resultType="SuccessVO">
        SELECT * FROM Success_t ORDER BY s_idx
    </select>    
    <select id="getSuccessDetail" resultType="SuccessVO">
        SELECT * FROM Success_t WHERE s_idx = #{s_idx}
    </select>
    <delete id="deleteSuccess" parameterType="SuccessVO">
        UPDATE Success_t
        SET active = #{active}
        WHERE s_idx = #{s_idx}
    </delete>
</mapper>    